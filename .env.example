# ===================================
# Portfolio Environment Configuration
# ===================================

# Availability Status
# Set to 'true' to show "Available for hire" badge
IS_AVAILABLE_FOR_HIRE=false

# Personal Information
FULL_NAME=Fajar Budi Cahyanto
JOB_TITLE=AI Infrastructure & Cloud Architect
CAREER_START_DATE=2019-01-01

# Contact Information
CONTACT_EMAIL=your.email@example.com

# Social Media Links
URL_GITHUB=https://github.com/yourusername
LINKEDIN_URL=https://linkedin.com/in/yourusername

# ===================================
# Sanity CMS Configuration
# ===================================

# Required: Your Sanity project ID (find at sanity.io/manage)
SANITY_PROJECT_ID=

# Required: Sanity dataset name (usually 'production')
SANITY_DATASET=production

# Optional: Sanity API version (defaults to v2024-01-01)
SANITY_API_VERSION=v2024-01-01

# Optional: Read token ONLY for private datasets. Not required for public read.
# NEVER expose this token in client bundle. If you need previews, deploy Draft Mode
# behind a server endpoint and proxy the token there.
# SANITY_API_READ_TOKEN=
